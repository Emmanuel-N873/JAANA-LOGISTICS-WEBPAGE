{
  "name": "jaana-logistics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "staff:bootstrap": "node scripts/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "staff:recover": "node scripts/recover-staff.mjs",
    "test:performance": "node scripts/check-performance.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "format:frontend": "node scripts/format-frontend.mjs",
    "check:frontend": "node scripts/format-frontend.mjs --check"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "jsbarcode": "^3.11.6",
    "qrcode-generator": "^1.4.4"
  }
}
